{
  "name": "cozydesk",
  "productName": "CozyDesk",
  "version": "2.0.0",
  "description": "CozyDesk 2.0 — bureau premium minimaliste : horloge centrale, widgets transparents, dock discret. 100% local.",
  "private": true,
  "author": "CozyDesk",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron . --dev",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run lint && npm run test && npm run build:electron && vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:nosign": "npm run build && electron-builder --win --x64 --publish never --config.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.7",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.469.0",
    "music-metadata": "^10.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
